import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error

# Example columns:
# time, actual_mw, ecmwf_forecast_mw, gfs_forecast_mw, icon_forecast_mw
df = pd.read_csv("forecast_data.csv", parse_dates=["time"])
df = df.sort_values("time")

df["hour"] = df["time"].dt.hour
df["month"] = df["time"].dt.month

df["avg_forecast"] = (
    df["ecmwf_forecast_mw"]
    + df["gfs_forecast_mw"]
    + df["icon_forecast_mw"]
) / 3

df["ecmwf_gfs_diff"] = df["ecmwf_forecast_mw"] - df["gfs_forecast_mw"]
df["ecmwf_icon_diff"] = df["ecmwf_forecast_mw"] - df["icon_forecast_mw"]

features = [
    "ecmwf_forecast_mw",
    "gfs_forecast_mw",
    "icon_forecast_mw",
    "avg_forecast",
    "ecmwf_gfs_diff",
    "ecmwf_icon_diff",
    "hour",
    "month"
]

target = "actual_mw"

split = int(len(df) * 0.8)

train = df.iloc[:split]
test = df.iloc[split:]

model = RandomForestRegressor(
    n_estimators=300,
    max_depth=8,
    random_state=42
)

model.fit(train[features], train[target])

test["meta_forecast_mw"] = model.predict(test[features])

def evaluate(name, actual, forecast):
    mae = mean_absolute_error(actual, forecast)
    rmse = np.sqrt(mean_squared_error(actual, forecast))
    bias = np.mean(forecast - actual)

    print(name)
    print(f"MAE  : {mae:.2f}")
    print(f"RMSE : {rmse:.2f}")
    print(f"Bias : {bias:.2f}")
    print()

evaluate("ECMWF", test[target], test["ecmwf_forecast_mw"])
evaluate("GFS", test[target], test["gfs_forecast_mw"])
evaluate("ICON", test[target], test["icon_forecast_mw"])
evaluate("Average Forecast", test[target], test["avg_forecast"])
evaluate("Meta Forecast", test[target], test["meta_forecast_mw"])
